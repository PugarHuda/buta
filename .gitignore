out/
cache/
# /lib/, not lib/. A bare pattern matches a directory named lib at ANY depth,
# and it was silently swallowing frontend/src/lib/ — seven source files
# including the ECIES client, the commitment scheme and the disclosure logic.
# A fresh clone of this repository did not contain the desk's core and could
# not build. Foundry's dependency directory is the one that belongs here, and
# it lives at the root.
/lib/
node_modules/
.env
config/proxy/*.toml
!config/proxy/*.example
frontend/node_modules/
frontend/.next/
*.log
.env.deployer

# Contract bindings, generated by scripts/generate-bindings.sh from the compiled
# contract. Committing them means the ABI and the Go can disagree; regenerating
# takes one command and needs only forge and node.
tools/pkg/contracts/*/autogen.go
tools/pkg/contracts/*/*.abi
tools/pkg/contracts/*/*.bin

# register-tee resume state: machine-local, and committing it makes a fresh
# clone skip steps for a machine that does not exist there.
config/register-tee.state

# node deps for the two helper scripts
node_modules/
package-lock.json
tunnel.log
.bidder.key

# Built binaries. 15 MB of unsigned exe in a hackathon repo reads as an
# unpruned tree, and nobody should run one from a clone anyway.
dev.exe
*.exe

# Agent harness. Useful locally, but it is scaffolding for how the work was
# done, not part of the product a reader is here to judge.
.claude/
testing/agents/
