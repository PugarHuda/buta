# TEE proxy URL.
#
# For local dev: leave empty so the frontend uses relative URLs; vite's dev
# server proxies /direct, /state, /action to VITE_PROXY_UPSTREAM (see below),
# avoiding CORS entirely because the browser only sees same-origin requests.
#
# For a bundle served outside vite: set this to a publicly-reachable proxy.
# Leave it EMPTY for the deployed desk — it then shows the demo book instead of
# polling an address no browser can reach. Note that Chrome blocks ports
# 6665-6669 as the IRC range, so pick 6670+.
VITE_TEE_PROXY_URL=

# Upstream TEE proxy that vite's dev proxy forwards to.
# Docker mode (default):         http://localhost:6674
# Local Go process mode:         http://localhost:6664
# Remote (e.g. GCP deployment):  https://tee-proxy-coston2-orderbook.flare.rocks
VITE_PROXY_UPSTREAM=http://localhost:6674

# API key for the proxy's /direct endpoint
# Must match DIRECT_API_KEY in the repo-root .env — the proxy compares them.
# It used to default to test-api-key-change-me on both sides, which is a key
# printed in every fork of the scaffold; the proxy has no default any more, so
# copy whatever you generated there.
VITE_DIRECT_API_KEY=

# WalletConnect project ID (get one at https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=

# Override for the deployed ButaInstructionSender contract address.
# Leave empty to use the value synced from the parent repo into generated.ts.
# Set this when the frontend is deployed separately from the extension (e.g.
# Vercel + remote TEE proxy), where generated.ts may not reflect the live
# deployment.
VITE_INSTRUCTION_SENDER=

# Token addresses, when they differ from the Coston2 defaults baked into
# config/tokens.ts. FXRP is what a winner pays in and the lot settles in; the
# desk links both to the explorer from the Audit panel.
#
# These were read by src/config/env.ts and documented nowhere, which is the
# exact shape of the bug that broke local dev once already: a variable the code
# depends on and the example file does not mention.
VITE_FXRP=
VITE_USDT0=
